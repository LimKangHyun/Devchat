events { }

http {
  resolver 127.0.0.11 valid=10s;

  server {
    listen 80;
    server_name thedevchat.duckdns.org;

    location /.well-known/acme-challenge/ {
      root /var/www/certbot;
    }

    location / {
      return 301 https://$host$request_uri;
    }
  }

  # AI 서버(dev-chat-ai)가 API 서버를 부르는 내부 전용 진입점. 항상 지금 활성화된 색(blue/green)으로 보낸다.
  # - 80은 https로 301을 돌려주고, 443은 인증서가 thedevchat.duckdns.org용이라 내부 이름으로는 검증이 실패한다.
  #   그래서 내부 호출만 받는 평문 포트를 따로 둔다.
  # - 8088은 docker-compose의 ports에 올리지 않는다. Docker 네트워크 안에서만 닿는다.
  # - dev-chat-network는 서브넷을 고정하지 않아 Docker가 고른 대역(예: 172.19.0.0/16)이 서버마다 다를 수 있다.
  #   대역 하나만 적으면 네트워크가 다시 만들어질 때 조용히 막히므로 사설 대역 전체를 허용한다.
  #   실제 보호는 포트 미공개와 API 서버의 내부 JWT 검증(InternalJwtAuthenticationFilter)이 맡는다.
  server {
    listen 8088;

    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
    deny all;

    location /internal-api/ {
      set $backend "dev-chat-backend-${ACTIVE_COLOR}:8080";
      rewrite ^/internal-api/(.*) /$1 break;
      proxy_pass http://$backend;
      proxy_http_version 1.1;
      proxy_set_header Host thedevchat.duckdns.org;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
      return 404;
    }
  }

  server {
    listen 443 ssl;
    server_name thedevchat.duckdns.org;

    ssl_certificate /etc/letsencrypt/live/thedevchat.duckdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/thedevchat.duckdns.org/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    gzip on;
    gzip_types text/css application/javascript image/png image/jpeg image/svg+xml;
    gzip_min_length 1000;
    gzip_comp_level 6;

    location ~* /static/.*\.(js|css)$ {
      set $frontend "dev-chat-frontend:80";
      proxy_pass http://$frontend;
      proxy_set_header Host $host;
      expires 1y;
      add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ^~ /grafana/ {
      set $grafana "grafana:3000";
      proxy_pass http://$grafana;
      proxy_http_version 1.1;
      proxy_set_header Host $http_host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ \.(png|jpg|jpeg|gif|ico|svg|webp)$ {
      set $frontend "dev-chat-frontend:80";
      proxy_pass http://$frontend;
      proxy_set_header Host $host;
      expires 6M;
      add_header Cache-Control "public, max-age=15552000";
    }

    location ~* \.(woff|woff2|ttf|otf)$ {
      set $frontend "dev-chat-frontend:80";
      proxy_pass http://$frontend;
      proxy_set_header Host $host;
      expires 1y;
      add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ~* \.(php|asp|aspx|jsp)$ {
      return 444;
    }

    location / {
      set $frontend "dev-chat-frontend:80";
      proxy_pass http://$frontend;
      proxy_http_version 1.1;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_intercept_errors on;
      error_page 404 = /index.html;
    }

    location /api/ {
      set $backend "dev-chat-backend-${ACTIVE_COLOR}:8080";
      rewrite ^/api/(.*) /$1 break;
      # 이미지 업로드용. 기본값(1m)이면 1MB가 넘는 사진이 413으로 막힌다.
      # 서버 한도(10MB)보다 조금 크게 둬서, 초과분은 서버가 JSON으로 안내하게 한다.
      client_max_body_size 11m;
      proxy_pass http://$backend;
      proxy_http_version 1.1;
      proxy_set_header Host thedevchat.duckdns.org;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_pass_header Set-Cookie;
      proxy_cookie_path /token/refresh /api/token/refresh;
      proxy_cookie_domain backend thedevchat.duckdns.org;
    }
    
    location /internal-api/ {
      allow 172.19.0.0/16;
      deny all;
      set $backend "dev-chat-backend-${ACTIVE_COLOR}:8080";
      rewrite ^/internal-api/(.*) /$1 break;
      proxy_pass http://$backend;
      proxy_http_version 1.1;
      proxy_set_header Host thedevchat.duckdns.org;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /swagger-ui/ {
      set $backend "dev-chat-backend-${ACTIVE_COLOR}:8080";
      proxy_pass http://$backend/swagger-ui/;
    }

    location /v3/ {
      set $backend "dev-chat-backend-${ACTIVE_COLOR}:8080";
      proxy_pass http://$backend/v3/;
    }

    location /ws {
      set $backend "dev-chat-backend-${ACTIVE_COLOR}:8080";
      proxy_pass http://$backend;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "Upgrade";
      # 기본 60초는 heartbeat가 잠깐 밀리면(백그라운드 탭 등) 연결을 끊는다
      proxy_read_timeout 300s;
      proxy_send_timeout 300s;
      proxy_set_header Host thedevchat.duckdns.org;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }
  }
}
